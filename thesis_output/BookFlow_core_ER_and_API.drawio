<mxfile host="app.diagrams.net" version="24.7.17" type="device"><diagram id="core_er" name="核心数据库ER图"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="BookFlow 核心数据库 ER 图" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#666666;fontSize=20;fontStyle=1;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="30" width="620" height="70" as="geometry"/></mxCell><mxCell id="wx_user" value="wx_user 用户基础表&lt;br&gt;用途：保存微信用户的基础身份和登录信息。&lt;br&gt;PK id&lt;br&gt;openid 微信唯一标识&lt;br&gt;unionid 微信开放平台标识&lt;br&gt;session_key 微信会话密钥&lt;br&gt;nickname, avatar_url, mobile&lt;br&gt;last_login_time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3FF;strokeColor=#2F6FB0;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="300" height="210" as="geometry"/></mxCell><mxCell id="user_profile" value="user_profile 学生认证资料表&lt;br&gt;用途：保存学生身份认证、学院专业和信誉信息。&lt;br&gt;PK id&lt;br&gt;FK user_id -&gt; wx_user.id&lt;br&gt;student_id 学号&lt;br&gt;real_name 真实姓名&lt;br&gt;school, department&lt;br&gt;auth_status 认证状态&lt;br&gt;credit_score 信誉分&lt;br&gt;student_card_image_url" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3FF;strokeColor=#2F6FB0;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="430" width="300" height="220" as="geometry"/></mxCell><mxCell id="user_address" value="user_address 收货地址表&lt;br&gt;用途：保存交易收货地址，订单创建时读取默认地址。&lt;br&gt;PK id&lt;br&gt;FK user_id -&gt; wx_user.id&lt;br&gt;receiver_name&lt;br&gt;receiver_phone&lt;br&gt;province, city, district&lt;br&gt;detail_address&lt;br&gt;is_default" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3FF;strokeColor=#2F6FB0;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="730" width="300" height="190" as="geometry"/></mxCell><mxCell id="book" value="book 书籍信息表&lt;br&gt;用途：保存二手书发布信息，是交易、批注、资源、路径的核心载体。&lt;br&gt;PK id&lt;br&gt;FK user_id -&gt; wx_user.id 发布者&lt;br&gt;isbn, title, author, publisher&lt;br&gt;cover_images 封面图&lt;br&gt;category 分类&lt;br&gt;price 售价&lt;br&gt;condition 成色&lt;br&gt;status 书籍状态&lt;br&gt;view_count, favorite_count, annotation_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#3A7D44;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="330" height="260" as="geometry"/></mxCell><mxCell id="book_order" value="order 订单表&lt;br&gt;用途：保存单本书交易订单和状态流转。&lt;br&gt;PK id&lt;br&gt;FK book_id -&gt; book.id&lt;br&gt;FK buyer_id -&gt; wx_user.id&lt;br&gt;FK seller_id -&gt; wx_user.id&lt;br&gt;order_no 订单号&lt;br&gt;total_amount 金额&lt;br&gt;status 订单状态&lt;br&gt;payment_time, delivery_time, receive_time&lt;br&gt;receiver_name, receiver_phone, receiver_address" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#B56A00;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="960" y="150" width="330" height="250" as="geometry"/></mxCell><mxCell id="order_issue" value="order_issue 订单纠纷表&lt;br&gt;用途：记录订单问题、纠纷和处理回复。&lt;br&gt;PK id&lt;br&gt;FK order_id -&gt; order.id&lt;br&gt;FK user_id -&gt; wx_user.id&lt;br&gt;type 问题类型&lt;br&gt;content 问题内容&lt;br&gt;reply_content 回复内容&lt;br&gt;reply_user_id 回复人&lt;br&gt;status 处理状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#B56A00;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1390" y="150" width="300" height="210" as="geometry"/></mxCell><mxCell id="annotation" value="annotation 批注表&lt;br&gt;用途：保存书籍页码批注，实现知识传承。&lt;br&gt;PK id&lt;br&gt;FK book_id -&gt; book.id&lt;br&gt;FK user_id -&gt; wx_user.id&lt;br&gt;page_num 页码&lt;br&gt;content 批注文字&lt;br&gt;position_text 位置描述&lt;br&gt;image_url 批注图片&lt;br&gt;type 批注类型&lt;br&gt;visibility 可见性&lt;br&gt;like_count 点赞数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#3A7D44;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="500" width="330" height="235" as="geometry"/></mxCell><mxCell id="annotation_like" value="annotation_like 批注点赞表&lt;br&gt;用途：记录用户对批注的点赞关系，避免重复点赞。&lt;br&gt;PK id&lt;br&gt;FK annotation_id -&gt; annotation.id&lt;br&gt;FK user_id -&gt; wx_user.id&lt;br&gt;create_time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAF7EA;strokeColor=#3A7D44;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="960" y="500" width="300" height="170" as="geometry"/></mxCell><mxCell id="resource" value="resource 配套资源表&lt;br&gt;用途：保存PDF、PPT、图片等学习资源，可绑定书籍或路径节点。&lt;br&gt;PK id&lt;br&gt;FK user_id -&gt; wx_user.id&lt;br&gt;book_id 可关联书籍&lt;br&gt;bind_type 绑定类型(book/pathNode)&lt;br&gt;bind_id 绑定对象ID&lt;br&gt;title 资源标题&lt;br&gt;type 资源类型&lt;br&gt;file_url 文件地址&lt;br&gt;visibility 可见性&lt;br&gt;download_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7154A8;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="805" width="330" height="230" as="geometry"/></mxCell><mxCell id="learning_path" value="learning_path 学习路径表&lt;br&gt;用途：保存用户创建的课程/书籍学习路线。&lt;br&gt;PK id&lt;br&gt;FK user_id -&gt; wx_user.id 创建者&lt;br&gt;book_id 可关联书籍&lt;br&gt;source_path_id 复制来源&lt;br&gt;title, description&lt;br&gt;cover_image&lt;br&gt;difficulty 难度&lt;br&gt;estimated_hours 预计时长&lt;br&gt;status 发布状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7154A8;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="960" y="790" width="330" height="225" as="geometry"/></mxCell><mxCell id="path_node" value="path_node 路径节点表&lt;br&gt;用途：保存学习路径的树形节点。&lt;br&gt;PK id&lt;br&gt;FK path_id -&gt; learning_path.id&lt;br&gt;parent_id 父节点&lt;br&gt;title 节点标题&lt;br&gt;description 节点说明&lt;br&gt;order_num 排序&lt;br&gt;estimated_minutes&lt;br&gt;resource_ids 绑定资源ID" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7154A8;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1390" y="790" width="300" height="210" as="geometry"/></mxCell><mxCell id="path_progress" value="user_path_progress 学习进度表&lt;br&gt;用途：记录用户对某条学习路径的整体进度。&lt;br&gt;PK id&lt;br&gt;FK user_id -&gt; wx_user.id&lt;br&gt;FK path_id -&gt; learning_path.id&lt;br&gt;progress_percent 进度百分比&lt;br&gt;completed_count 完成节点数&lt;br&gt;started_at 开始时间&lt;br&gt;last_learn_time 最近学习时间" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3ECFF;strokeColor=#7154A8;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1390" y="1080" width="300" height="210" as="geometry"/></mxCell><mxCell id="post" value="post 社区帖子表&lt;br&gt;用途：保存动态、经验分享和路径分享内容。&lt;br&gt;PK id&lt;br&gt;FK user_id -&gt; wx_user.id&lt;br&gt;title, content&lt;br&gt;type 帖子类型&lt;br&gt;shared_path_id 分享路径ID&lt;br&gt;view_count, like_count, comment_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#B84646;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="1020" width="300" height="200" as="geometry"/></mxCell><mxCell id="comment" value="comment 评论表&lt;br&gt;用途：保存社区帖子评论。&lt;br&gt;PK id&lt;br&gt;FK post_id -&gt; post.id&lt;br&gt;FK user_id -&gt; wx_user.id&lt;br&gt;content 评论内容&lt;br&gt;like_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#B84646;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="500" y="1120" width="300" height="160" as="geometry"/></mxCell><mxCell id="chat_session" value="chat_session 私信会话表&lt;br&gt;用途：围绕书籍建立买卖双方沟通会话。&lt;br&gt;PK id&lt;br&gt;FK book_id -&gt; book.id&lt;br&gt;FK buyer_id -&gt; wx_user.id&lt;br&gt;FK seller_id -&gt; wx_user.id&lt;br&gt;last_message&lt;br&gt;last_message_time&lt;br&gt;unread_count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#B84646;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="960" y="1120" width="300" height="190" as="geometry"/></mxCell><mxCell id="chat_message" value="chat_message 私信消息表&lt;br&gt;用途：保存会话中的具体消息。&lt;br&gt;PK id&lt;br&gt;FK session_id -&gt; chat_session.id&lt;br&gt;FK sender_id -&gt; wx_user.id&lt;br&gt;content 消息内容&lt;br&gt;is_read 是否已读" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0F0;strokeColor=#B84646;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1390" y="1350" width="300" height="160" as="geometry"/></mxCell><mxCell id="e1" value="1:1 认证资料" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="wx_user" target="user_profile"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="1:N 地址" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="wx_user" target="user_address"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1:N 发布书籍" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="wx_user" target="book"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="1:N 产生订单" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="book" target="book_order"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="1:N 纠纷记录" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="book_order" target="order_issue"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="1:N 书籍批注" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="book" target="annotation"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="1:N 批注点赞" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="annotation" target="annotation_like"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="1:N 配套资源" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="book" target="resource"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="1:N 关联路径" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="book" target="learning_path"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="1:N 路径节点" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="learning_path" target="path_node"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="1:N 学习进度" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="learning_path" target="path_progress"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="1:N 发布动态" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="wx_user" target="post"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="1:N 评论" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="post" target="comment"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="1:N 交易会话" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="book" target="chat_session"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="1:N 消息" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=ERmany;startArrow=ERone;strokeWidth=2;fontSize=12;fontFamily=Microsoft YaHei;" edge="1" parent="1" source="chat_session" target="chat_message"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="core_api" name="核心接口说明"><mxGraphModel dx="1800" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2300" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="api_title" value="BookFlow 核心接口说明" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4F4;strokeColor=#666666;fontSize=20;fontStyle=1;fontFamily=Microsoft YaHei;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="620" y="30" width="620" height="70" as="geometry"/></mxCell><mxCell id="api0" value="模块：用户登录与认证&lt;br&gt;方法：POST&lt;br&gt;路径：/user/auth/wechat&lt;br&gt;用途：微信小程序登录，换取openid并签发JWT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#B56A00;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="150" width="520" height="150" as="geometry"/></mxCell><mxCell id="api1" value="模块：用户登录与认证&lt;br&gt;方法：GET&lt;br&gt;路径：/user/auth/check&lt;br&gt;用途：校验登录态，刷新Token有效期" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#B56A00;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="520" height="150" as="geometry"/></mxCell><mxCell id="api2" value="模块：用户资料&lt;br&gt;方法：GET&lt;br&gt;路径：/user/profile&lt;br&gt;用途：获取用户资料和学生认证信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#B56A00;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="150" width="520" height="150" as="geometry"/></mxCell><mxCell id="api3" value="模块：用户资料&lt;br&gt;方法：POST&lt;br&gt;路径：/user/profile/verify-student&lt;br&gt;用途：提交学生认证资料" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#B56A00;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="330" width="520" height="150" as="geometry"/></mxCell><mxCell id="api4" value="模块：地址管理&lt;br&gt;方法：GET&lt;br&gt;路径：/user/address/list&lt;br&gt;用途：查询当前用户收货地址" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#B56A00;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="330" width="520" height="150" as="geometry"/></mxCell><mxCell id="api5" value="模块：地址管理&lt;br&gt;方法：POST&lt;br&gt;路径：/user/address/save&lt;br&gt;用途：新增或修改收货地址" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#B56A00;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="330" width="520" height="150" as="geometry"/></mxCell><mxCell id="api6" value="模块：书籍交易&lt;br&gt;方法：GET&lt;br&gt;路径：/book/list&lt;br&gt;用途：首页书籍列表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#B56A00;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="80" y="510" width="520" height="150" as="geometry"/></mxCell><mxCell id="api7" value="模块：书籍交易&lt;br&gt;方法：GET&lt;br&gt;路径：/book/search&lt;br&gt;用途：按关键词和分类搜索书籍" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#B56A00;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="640" y="510" width="520" height="150" as="geometry"/></mxCell><mxCell id="api8" value="模块：书籍交易&lt;br&gt;方法：GET&lt;br&gt;路径：/book/detail&lt;br&gt;用途：查看书籍详情、卖家、批注、资源和路径信息" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#B56A00;fontSize=13;fontFamily=Microsoft YaHei;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1"><mxGeometry x="1200" y="510" width="520" height="150" as="geometry"/></mxCell><mxCell id="api9" value="模块：书籍交易&lt;br&gt;方法：POST&lt;br&gt;路径：/book/publish&lt;br&gt;用途：发布二手书" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E3;strokeColor=#B5